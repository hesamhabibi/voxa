# Required in production: generate a long, random value and keep it secret.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
OTP_HASH_SECRET=replace-with-a-different-long-random-secret
# Keep true only while test OTPs are deliberately enabled and visible in Console.
OTP_TEST_MODE=true

# PostgreSQL connection string for the membership service.
POSTGRES_URL=postgresql://voxa:password@localhost:5432/voxa
DATABASE_URL=postgresql://voxa:password@localhost:5432/voxa
PRISMA_DATABASE_URL=postgresql://voxa:password@localhost:5432/voxa

# SMS provider settings; test OTP logging is only for local development.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER=
